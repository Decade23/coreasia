# ─────────────────────────────────────────────────────────────────────────────
# CoreAsia Gateway — PRODUCTION environment template.
#
#   cp .env.prod.example .env.prod   &&   fill in REAL values.
#   NEVER commit .env.prod. (It is referenced by docker-compose.prod.yml.)
#
# These env vars OVERRIDE configs/config.yaml inside the container (cleanenv
# overlays env on top of YAML). The values below are placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=coreasia-gateway
APP_ENV=production
APP_PORT=8081
APP_DEBUG=false

# ── Database (gateway connects to the `postgres` service) ────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=coreasia
DB_PASSWORD=CHANGE_ME_strong_db_password          # strong, random
DB_NAME=coreasia_gateway
DB_SSL_MODE=disable                               # disable: traffic stays on the internal docker network
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ── Postgres container init vars (MUST match DB_* above) ─────────────────────
POSTGRES_USER=coreasia
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password    # == DB_PASSWORD
POSTGRES_DB=coreasia_gateway                       # == DB_NAME

# ── Redis (gateway connects to the `redis` service) ──────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                                    # empty: redis is internal-only
REDIS_DB=0

# ── JWT (admin auth) ─────────────────────────────────────────────────────────
# Generate a random 32+ char secret, e.g.:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_random_min_32_chars_secret
JWT_ACCESS_TTL=60m
JWT_REFRESH_TTL=720h
JWT_ISSUER=coreasia-gateway

# ── Admin seed (auto-created on first boot if no admin exists) ────────────────
ADMIN_EMAIL=admin@coreasia.id
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ADMIN_NAME=Administrator

# ── Email (transactional — license-key delivery via Resend) ──────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=CoreAsia <noreply@coreasia.id>

# ── Payments — inbound webhook secret ────────────────────────────────────────
# Shared token to authenticate Mayar's purchase webhook (POST /api/cad/purchase/mayar).
MAYAR_WEBHOOK_TOKEN=CHANGE_ME_mayar_webhook_token

# ── Payments — callback verification (OUTBOUND to Mayar) ──────────────────────
# Independent confirmation that a "paid" webhook is genuine before a license key
# is minted (defends against spoofed webhooks). Get the API key from the Mayar
# dashboard. Leave MAYAR_VERIFY=false until MAYAR_API_KEY is set — when false the
# webhook behaviour is unchanged.
MAYAR_API_KEY=
MAYAR_API_BASE=https://api.mayar.id/hl/v1
MAYAR_VERIFY=false

# ── CAD license signing (server-side "Generate" key di admin console) ─────────
# Seed Ed25519 (base64url, 32-byte) untuk MENANDATANGANI license key yang dibuat
# lewat tombol "Generate". WAJIB seed private yang berpasangan dgn public key yang
# di-embed di app (LICENSE_PUBKEY). Kosong = fitur Generate nonaktif (Import tetap jalan).
# Sumber: PRIVATE_KEY di .secrets/license-keypair.txt (repo downloader). RAHASIA — jangan commit.
CAD_LICENSE_SIGNING_KEY=

# ── Mounter license signing (CoreAsia Mounter — keypair TERPISAH dari CAD) ────
# Seed Ed25519 (base64url, 32-byte) khusus produk Mounter; berpasangan dengan
# LicenseVerifier.licensePublicKey yang di-embed di app Mounter. Webhook Gumroad
# yang sama melayani kedua produk (routing via permalink: "mounter" vs
# "coreasia-download-manager"). Kosong = penerbitan key Mounter nonaktif.
# Sumber: ~/DEV/disk-dev/.secrets/license-ed25519.private.key (mesin owner). RAHASIA.
MOUNTER_LICENSE_SIGNING_KEY=

# ── Gumroad purchase webhook (otomatis: generate key + email pembeli) ──────────
# Shared token diselipkan di URL Gumroad Ping (Settings → Advanced → Ping):
#   https://api.coreasia.id/api/cad/purchase/gumroad?token=<GUMROAD_PING_TOKEN>
# Kosong = webhook Gumroad ditolak (fail closed). Butuh CAD_LICENSE_SIGNING_KEY ter-set.
GUMROAD_PING_TOKEN=CHANGE_ME_gumroad_ping_token
# (Opsional) bila diisi, field seller_id pada ping harus cocok (proteksi tambahan).
GUMROAD_SELLER_ID=

# (Optional) Midtrans — fill if Midtrans Snap is enabled.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_NOTIFICATION_URL=https://api.coreasia.id/api/cad/purchase/midtrans
MIDTRANS_MERCHANT_NAME=CoreAsia

# ── Cloudflare R2 (article images / asset storage) ───────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=coreasia-articles
R2_PUBLIC_URL=

# ── AI (article-generator bot) — optional, only if the bot is used ───────────
AI_API_KEY=
AI_PROVIDER=claude
AI_MODEL=claude-sonnet-4-20250514
UNSPLASH_ACCESS_KEY=

# ── CORS — allowed browser origins (comma-separated) ─────────────────────────
CORS_ORIGINS=https://coreasia.id,https://www.coreasia.id
